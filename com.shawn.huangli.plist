<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shawn.huangli</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.11</string>
        <string>/Users/shawn/Documents/ClaudeCode/Huangli/huangli_daily.py</string>
    </array>

    <!-- 登录时自动运行一次；脚本内部检查当天是否已跑，避免重复 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/shawn/Documents/ClaudeCode/Huangli/logs/huangli.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shawn/Documents/ClaudeCode/Huangli/logs/huangli.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/shawn</string>
    </dict>
</dict>
</plist>
